<script>
(function() {
  var banner = document.getElementById('first-class-banner');
  if (!banner) return;

  function setDismissedCookie() {
    var expires = new Date();
    expires.setFullYear(expires.getFullYear() + 1);
    document.cookie = 'first_class_free_banner_dismissed=1; path=/; expires=' + expires.toUTCString();
  }

  banner.querySelector('.first-class-banner-close').addEventListener('click', function() {
    setDismissedCookie();
    banner.style.display = 'none';
  });
})();
</script>
