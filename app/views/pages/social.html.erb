<div class="col-span-11 p-4">
  <h1>Social</h1>
  <p class="mb-4">
    Connect with the Okinawan Karate Club of Madison on social media.
  </p>
  <iframe
      src="https://www.instagram.com/karate.madison/embed"
      class="w-full border-2 border-gray-200 rounded-lg"
      style="height: 480px;"
      title="Instagram feed for karate.madison"
      allowtransparency="true"
      loading="lazy">
    </iframe>
    <p></p>
    <iframe 
      src="https://www.youtube.com/embed/?listType=user_uploads&list=UCTwMcwZeFsctNou93tjVJ8A" 
      class="w-full border-0"
      style="height: 315px;"
      title="YouTube channel for the Okinawan Karate Club of Madison"
      allow"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowtransparency="true"
      loading="lazy">
    </iframe>
</div>
<div class="col-span-11 md:col-span-8 md:col-end">
  <%= render "layouts/contact" %>
</div>
