<div class="col-span-11 p-0">
  <h1>Social</h1>
  <iframe 
    src="https://www.youtube.com/embed/videoseries?list=UUTwMcwZeFsctNou93tjVJ8A"
    class="w-full border-0"
    style="height: 315px;"
    title="YouTube channel for the Okinawan Karate Club of Madison"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowtransparency="true"
    loading="lazy">
  </iframe>
  <p class="mb-4"></p>
  <iframe
    src="https://www.instagram.com/karate.madison/embed"
    class="w-full border-2 border-gray-200 rounded-lg"
    style="height: 480px;"
    title="Instagram feed for karate.madison"
    allowtransparency="true"
    loading="lazy">
  </iframe>
</div>
<div class="col-span-11 md:col-span-8 md:col-end">
  <%= render "layouts/contact" %>
</div>
