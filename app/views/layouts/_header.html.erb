			<td class="border border-black border-l-[5px] border-l-brand-red px-4 py-2 <%= @location == :Social ? 'bg-nav-active' : 'bg-content-bg' %>"><%= link_to 'Social', :pages_social, class: "block text-center hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2" %></td>
		</tr>
	</table>
</nav>
