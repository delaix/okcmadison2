<div class="col-span-full">
	<div class="relative">
		<%= image_tag "logo.png", alt: "Okinawan Karate Club of Madison logo" %>
	</div>
</div>
<div class="col-span-full bg-brand-red border-r-2 border-b-[3px] border-black text-right text-brand-gold-alt">
	<%= @location %>&nbsp;
</div>
<nav class="col-span-full mt-0.5">
	<table class="w-full border-collapse border border-black">
		<tr>
			<td class="border border-black border-l-[5px] border-l-brand-red px-4 py-2 <%= @location == :Home ? 'bg-nav-active' : 'bg-content-bg' %>"><%= link_to 'Home', :pages_home, class: "block text-center hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2" %></td>
			<td class="border border-black border-l-[5px] border-l-brand-red px-4 py-2 <%= @location == :About ? 'bg-nav-active' : 'bg-content-bg' %>"><%= link_to 'About', :pages_about, class: "block text-center hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2" %></td>
			<td class="border border-black border-l-[5px] border-l-brand-red px-4 py-2 <%= @location == :Classes ? 'bg-nav-active' : 'bg-content-bg' %>"><%= link_to 'Classes', :pages_classes, class: "block text-center hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-brand-gold focus:ring-offset-2" %></td>
