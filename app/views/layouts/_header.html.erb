<div class="col-span-full">
	<div class="relative">
		<%= image_tag "logo.png" %>
	</div>
</div>
<div class="col-span-full bg-brand-red border-r-2 border-b-[3px] border-black text-right text-brand-gold-alt">
	<%= @location %>&nbsp;
</div>
<div class="col-span-full">
	<table class="leftlinks mt-0.5">
		<tr>
			<td class="<%= @location == :Home ? 'bg-nav-active' : 'bg-content-bg' %>"><%= link_to 'Home', :pages_home %></td>
			<td class="<%= @location == :About ? 'bg-nav-active' : 'bg-content-bg' %>"><%= link_to 'About', :pages_about %></td>
			<td class="<%= @location == :Classes ? 'bg-nav-active' : 'bg-content-bg' %>"><%= link_to 'Classes', :pages_classes %></td>
			<td class="<%= @location == 'Practical Karate' ? 'bg-nav-active' : 'bg-content-bg' %>"><%= link_to 'Practical Karate', :pages_practical %></td>
		</tr>
	</table>
</div>
